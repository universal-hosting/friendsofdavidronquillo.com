p.p1 {
	padding: 0;
	margin-top: 0;
	margin-right: 0;
	margin-bottom: 0;
	margin-left: 0;
}

a.pagenav:link {
	font-family:helvetica,arial,sans-serif;
	color:white;
	font-size:16px;
    text-decoration: none;
}

a.pagenav:visited {
	font-family:helvetica,arial,sans-serif;
	color:white;
	font-size:16px;
    text-decoration: none;
}

a.pagenav:active {
	font-family:helvetica,arial,sans-serif;
	font-size:16px;
    color: #ffffbd;
    text-decoration: none;
}

a.pagenav:hover {
	font-family:helvetica,arial,sans-serif;
	font-size:16px;
    color: #ffffbd;
    text-decoration: none;
}

a.docnav:link {
	font-family:helvetica,arial,sans-serif;
	color:darkblue;
	font-size:14px;
	font-weight:normal;
	font-style: normal;
    text-decoration: none;
}

a.docnav:visited {
	font-family:helvetica,arial,sans-serif;
	color:darkblue;
	font-size:14px;
	font-weight:normal;
	font-style: normal;
    text-decoration: none;
}

a.docnav:active {
	font-family:helvetica,arial,sans-serif;
	color:darkblue;
	font-size:14px;
	font-weight:normal;
	font-style: normal;
    text-decoration: none;
}

a.docnav:hover {
	font-family:helvetica,arial,sans-serif;
	color:blue;
	font-size:14px;
	font-weight:normal;
	font-style: normal;
    text-decoration: none;
}

